# Central source access, managed by the Lanilot operator. Never commit .env.
# API access/agreements must first be obtained from each provider.
# MODE=demo (default) or live; ENVIRONMENT=sandbox or production.
# CHECK_URL: provider-approved authenticated read-only HTTPS GET endpoint,
# on the provider's own domain, without query parameters. No booking endpoints.
# TOKEN: existing access token (Bearer). API_KEY: x-api-key when required.
# Token issuance/refresh and load import are separate, not implemented here.
LANILOT_DAT_MODE=demo
LANILOT_DAT_CHECK_URL=
LANILOT_DAT_TOKEN=
LANILOT_DAT_API_KEY=
LANILOT_DAT_ACCOUNT=
LANILOT_DAT_ENVIRONMENT=sandbox
LANILOT_DAT_ENABLED=true
LANILOT_TRUCKSTOP_MODE=demo
LANILOT_TRUCKSTOP_CHECK_URL=
LANILOT_TRUCKSTOP_TOKEN=
LANILOT_TRUCKSTOP_API_KEY=
LANILOT_TRUCKSTOP_ACCOUNT=
LANILOT_TRUCKSTOP_ENVIRONMENT=sandbox
LANILOT_TRUCKSTOP_ENABLED=true
LANILOT_RXO_MODE=demo
LANILOT_RXO_CHECK_URL=
LANILOT_RXO_TOKEN=
LANILOT_RXO_API_KEY=
LANILOT_RXO_ACCOUNT=
LANILOT_RXO_ENVIRONMENT=sandbox
LANILOT_RXO_ENABLED=true
LANILOT_UBER_MODE=demo
LANILOT_UBER_CHECK_URL=
LANILOT_UBER_TOKEN=
LANILOT_UBER_API_KEY=
LANILOT_UBER_ACCOUNT=
LANILOT_UBER_ENVIRONMENT=sandbox
LANILOT_UBER_ENABLED=false

# Telegram company scope. This local MVP has one workspace; do not expose it
# as a multi-tenant service without authenticated organization scoping.
LANILOT_COMPANY_ID=workspace
# OpenAI Responses model supporting Structured Outputs; set an available model.
OPENAI_API_KEY=
LANILOT_AI_MODEL=
# Public HTTPS app origin for the "Open load" button; optional for local use.
LANILOT_PUBLIC_URL=

# --- Live data providers (empty = demo mode). Values are read only on the server, never sent to the browser. ---
# ELD: every configured provider is polled and merged (mixed fleets). Vehicles are matched to trucks
# by ELD vehicle name/number = truck number or plate.
# Samsara: API token (Settings → API Tokens, read Vehicles + HOS). Region: us | eu | ca.
LANILOT_SAMSARA_TOKEN=
LANILOT_SAMSARA_REGION=us
# Motive (KeepTruckin): company API key, sent as X-Api-Key.
LANILOT_MOTIVE_API_KEY=
# Geotab (MyGeotab): service user with read access; server defaults to my.geotab.com.
LANILOT_GEOTAB_USERNAME=
LANILOT_GEOTAB_PASSWORD=
LANILOT_GEOTAB_DATABASE=
LANILOT_GEOTAB_SERVER=my.geotab.com

# FMCSA QCMobile API: free webKey (login.gov) — legal name and authority by MC/DOT in broker checks.
LANILOT_FMCSA_WEBKEY=

# Factoring credit check. There is no public API: the factoring company gives API access by agreement.
# Pick the provider (rts | otr | triumph | apex | ecapital | custom) and describe its API:
LANILOT_FACTORING_PROVIDER=
# URL template (HTTPS). Placeholders: {mc} {dot} {name}. Example: https://api.example.com/credit?mc={mc}
LANILOT_FACTORING_RTS_URL=
# Auth: Bearer token and/or API key (header name, default x-api-key).
LANILOT_FACTORING_RTS_TOKEN=
LANILOT_FACTORING_RTS_API_KEY=
LANILOT_FACTORING_RTS_KEY_HEADER=x-api-key
# JSON fields in the response (dot paths) and which status values mean approved / declined.
LANILOT_FACTORING_RTS_FIELD_STATUS=status
LANILOT_FACTORING_RTS_FIELD_LIMIT=creditLimit
LANILOT_FACTORING_RTS_FIELD_DAYS=daysToPay
LANILOT_FACTORING_RTS_APPROVED=approved,yes,buy
LANILOT_FACTORING_RTS_DECLINED=declined,no,no buy
# Broker MC used by the "Check" button on the Integrations page.
LANILOT_FACTORING_RTS_TEST_MC=
# Same variables with OTR / TRIUMPH / APEX / ECAPITAL / CUSTOM instead of RTS for other companies.

# SaaS: companies on subdomains <slug>.LANILOT_BASE_DOMAIN; app.<domain> is the primary company.
LANILOT_BASE_DOMAIN=lanilot.com
# One-time code to create the first owner of the primary company. If empty, a code is printed to the log at start.
LANILOT_SETUP_TOKEN=
